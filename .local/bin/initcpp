#!/bin/bash
mkdir -p src build

# Add style guide reminder
cat <<'EOF' >style.md
# Google code style basics
- Variables -> snake_case -> my_variable, point_count
- Functions/Methods -> PascalCase -> Distance(), ComputeArea()
- Classes/Structs -> PascalCase -> Point, User
- Constant/constexpr -> kPascaleCase -> kMaxSize, kDefaultValue
- Macros -> UPPER_SNAKE_CASE -> MY_MACRO
- Namespaces -> snake_cases -> my_namespace
- Enum values -> kPascalCasse -> kEnumValue
- file names -> snake_cases -> my_class.h
EOF

# Basic main func
cat <<'EOF' >src/main.cpp
#include <iostream>
int main() {
  std::cout << "Hello, World!" << '\n';
  return 0;
}
EOF

# Add clang-format Google style
cat <<'EOF' >.clang-format
BasedOnStyle: Google
AlignAfterOpenBracket: BlockIndent
BinPackParameters: false
BinPackArguments: false
ColumnLimit: 80
EOF

# Create cmake file
cat <<'EOF' >CMakeLists.txt
cmake_minimum_required(VERSION 3.20)

project(App)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# find_package(example REQUIRED)
add_executable(App src/main.cpp) 
# target_include_directories(main PRIVATE src include)
# target_link_libraries(main PRIVATE raylib)
EOF

cat <<'EOF' >.clangd
CompileFlags:
  CompilationDatabase: build/
EOF

# Configure clang tidy
cat <<'EOF' >.clang-tidy
Checks: 'clang-diagnostic-*,clang-analyzer-*,google-*,modernize-*,readability-*'
WarningsAsErrors: ''
EOF

# Remove build from git tracking
cat <<'EOF' >.gitignore
build/
EOF

# git init -q
# git add .
# git commit -m "init" -q
cd build
cmake -G Ninja ..
ninja
cd ..
