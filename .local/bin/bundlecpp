#!/usr/bin/env python3
import argparse
import subprocess
from pathlib import Path

MAIN_CPP = """\
#include <iostream>

int main() {
  std::cout << "Hello, World!" << '\\n';
  return 0;
}
"""

CLANG_FORMAT = """\
BasedOnStyle: Google
AccessModifierOffset: -2
BinPackParameters: false
BinPackArguments: false
ColumnLimit: 80
IncludeBlocks: Preserve
"""

CMAKE_LISTS = """\
cmake_minimum_required(VERSION 3.20)
project({name} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

file(GLOB_RECURSE SOURCES "src/*.cpp")
add_executable({name} ${{SOURCES}})
target_include_directories({name} PRIVATE src)
"""

CLANGD = """\
CompileFlags:
  CompilationDatabase: build/
  Add: [-std=c++20]
"""

CLANG_TIDY = """\
Checks: '-*,readability-identifier-naming'
CheckOptions:
  # Functions → PascalCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase

  # Local variables → camelCase
  - key: readability-identifier-naming.VariableCase
    value: camelBack

  # Parameters → camelCase
  - key: readability-identifier-naming.ParameterCase
    value: camelBack

  # Classes → PascalCase
  - key: readability-identifier-naming.ClassCase
    value: CamelCase

  # Structs → PascalCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase

  # Private members → trailing underscore
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case

  # Protected members → trailing underscore
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: _
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case

  # Constants (static constexpr / global) → kPascalCase
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k

  # Enums → PascalCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase

  # Enum values → kPascalCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
"""

GITIGNORE = """\
build/
compile_commands.json
"""


def write_file(path: Path, content: str, overwrite: bool = False):
    if path.exists() and not overwrite:
        print(f"  skipping {path} (already exists)")
        return
    path.write_text(content)
    print(f"  wrote {path}")


def setup_project(name: str, overwrite: bool):
    src = Path("src")
    src.mkdir(exist_ok=True)

    write_file(src / "main.cpp", MAIN_CPP, overwrite)
    write_file(Path(".clang-format"), CLANG_FORMAT, overwrite)
    write_file(Path("CMakeLists.txt"), CMAKE_LISTS.format(name=name), overwrite)
    write_file(Path(".clangd"), CLANGD, overwrite)
    write_file(Path(".clang-tidy"), CLANG_TIDY, overwrite)
    write_file(Path(".gitignore"), GITIGNORE, overwrite)


def build():
    build_dir = Path("build")
    if not build_dir.exists():
        print("  configuring cmake...")
        subprocess.run(["cmake", "-S", ".", "-B", "build", "-G", "Ninja"], check=True)

    print("  building...")
    subprocess.run(["cmake", "--build", "build"], check=True)

    symlink = Path("compile_commands.json")
    if not symlink.exists():
        symlink.symlink_to("build/compile_commands.json")
        print("  linked compile_commands.json")


def main():
    parser = argparse.ArgumentParser(description="C++ project setup")
    parser.add_argument("--name", default="app", help="project name (default: app)")
    parser.add_argument(
        "--overwrite", action="store_true", help="overwrite existing files"
    )
    parser.add_argument("--no-build", action="store_true", help="skip build step")
    args = parser.parse_args()

    print(f"setting up project '{args.name}'...")
    setup_project(args.name, args.overwrite)

    if not args.no_build:
        build()

    print("done.")


if __name__ == "__main__":
    main()
