* {
  border-radius: 0;
  font-family: JetBrains Mono Nerd Font;
  font-size: 12px;
  font-weight: 700;
  margin: 0 1px;
}

#waybar {
  background: transparent;
}

#clock,
#pulseaudio,
#network,
#backlight,
#battery,
#power-profiles-daemon {
  padding: 2px 10px;
  margin: 2px 3px;
  color: #101010;
  background-color: #ffffff;
  border-radius: 6px;
}

#clock,
#custom-power {
  font-weight: 900;
}
