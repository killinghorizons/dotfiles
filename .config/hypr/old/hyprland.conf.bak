env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24
env = ELECTRON_OZONE_PLATFORM_HINT,auto

# env = AQ_DRM_DEVICES,/dev/dri/card1:/dev/dri/card0

env = LIBVA_DRIVER_NAME,nvidia
env = XDG_SESSION_TYPE,wayland
env = GBM_BACKEND,nvidia-drm
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = WLR_NO_HARDWARE_CURSORS,1

monitor = eDP-1,1920x1080@144,0x0,1,vrr,1

$terminal = foot
$fileManager = nautilus

#for libadwaita gtk4 apps you can use this command:
# exec-once = hypridle # Lock screen when idle.
# exec-once = gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
# exec-once = gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3"
# exec-once = systemctl --user start hyprpolkitagent
# exec-once = wl-paste --watch cliphist store # Clipboard.
# exec-once = nm-applet &
# exec-once = waybar
exec-once = hyprsunset
# exec-once = swaync
# exec-once = swaybg -i $HOME/.config/hypr/walls/arch.png
exec-once = qs -c noctalia-shell

general {
    gaps_in = 10
    gaps_out = 10
    border_size = 2
    resize_on_border = true
    col.active_border = rgb(d0b5f3) # Purple border for active windows.
    allow_tearing = false
}

ecosystem {
    no_update_news = true
    no_donation_nag = true
}

decoration {
    rounding = 0
    rounding_power = 0

    blur {
        enabled = false
    }
}

cursor {
    no_hardware_cursors = false
}

animations {
    enabled = yes
    bezier = easeOut, 0.2, 1, 0.2, 1
    animation = windows, 1, 5, easeOut
    animation = windowsIn, 1, 5, default, popin
    animation = workspaces, 1, 5, default
}

master {
    new_status = master
}

misc {
    disable_hyprland_logo = true
    mouse_move_enables_dpms = true
    key_press_enables_dpms = true
    vrr = 1 # Enables Variable Refresh Rate if supported
}

xwayland {
    force_zero_scaling = true
}

input {
    kb_layout = fr

    follow_mouse = 1
    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.
    accel_profile = flat

    touchpad {
        natural_scroll = true
    }
}


# See https://wiki.hypr.land/Configuring/Keywords/
$mainMod = ALT # Sets "Alt" key as main modifier

# Example binds, see https://wiki.hypr.land/Configuring/Binds/ for more
bind = $mainMod SHIFT, F, fullscreen, 0
bind = $mainMod , F, fullscreen, 1
bind = $mainMod, C, centerwindow
bind = $mainMod, Q, killactive,
bind = $mainMod SHIFT, Q, exec, $HOME/.config/hypr/scripts/exit-hypr.sh
bind = $mainMod SHIFT, E, exec, $HOME/.config/rofi/scripts/powermenu.sh
bind = $mainMod SHIFT, R, exec, hyprctl reload
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, P, pseudo,


bind = $mainMod, Return, exec, $terminal
# bind = $mainMod, D, exec, rofi -show drun
bind = $mainMod, D, exec, rofi -show drun
bind = $mainMod, B, exec, google-chrome-stable --ozone-platform=wayland
# bind = $mainMod, B, exec, firefox

# Focus window
bind = $mainMod, H, movefocus, l
bind = $mainMod, J, movefocus, d
bind = $mainMod, K, movefocus, u
bind = $mainMod, L, movefocus, r

# Move window
bind = $mainMod SHIFT, H, movewindow, l
bind = $mainMod SHIFT, J, movewindow, d
bind = $mainMod SHIFT, K, movewindow, u
bind = $mainMod SHIFT, L, movewindow, r

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, ampersand, workspace, 1
bind = $mainMod, eacute, workspace, 2
bind = $mainMod, quotedbl, workspace, 3
bind = $mainMod, apostrophe, workspace, 4
bind = $mainMod, parenleft, workspace, 5
bind = $mainMod, minus, workspace, 6
bind = $mainMod, egrave, workspace, 7
bind = $mainMod, underscore, workspace, 8
bind = $mainMod, ccedilla, workspace, 9
bind = $mainMod, agrave, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, ampersand, movetoworkspace, 1
bind = $mainMod SHIFT, eacute, movetoworkspace, 2
bind = $mainMod SHIFT, quotedbl, movetoworkspace, 3
bind = $mainMod SHIFT, apostrophe, movetoworkspace, 4
bind = $mainMod SHIFT, parenleft, movetoworkspace, 5
bind = $mainMod SHIFT, minus, movetoworkspace, 6
bind = $mainMod SHIFT, egrave, movetoworkspace, 7
bind = $mainMod SHIFT, underscore, movetoworkspace, 8
bind = $mainMod SHIFT, ccedilla, movetoworkspace, 9
bind = $mainMod SHIFT, agrave, movetoworkspace, 10

# Example special workspace (scratchpad)
bind = $mainMod, S, togglespecialworkspace, magic
bind = $mainMod SHIFT, S, movetoworkspace, special:magic

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Laptop multimedia keys for volume and LCD brightness
binde = , XF86AudioLowerVolume, exec, $HOME/.config/hypr/scripts/volume.sh --dec
binde = , XF86AudioRaiseVolume, exec, $HOME/.config/hypr/scripts/volume.sh --inc
bind = , XF86AudioMute, exec, $HOME/.config/hypr/scripts/volume.sh --toggle-mut
binde = , XF86MonBrightnessDown, exec, $HOME/.config/hypr/scripts/backlight.sh --dec
binde = , XF86MonBrightnessUp, exec, $HOME/.config/hypr/scripts/backlight.sh --inc
binde = $mainMod SHIFT, DOWN ,  exec, $HOME/.config/hypr/scripts/backlight.sh --dec
binde = $mainMod SHIFT, UP ,  exec, $HOME/.config/hypr/scripts/backlight.sh --inc

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous


# GTK3 editor:
windowrule = match:class nwg-look, float on, size 800 500

# File dialogs:
windowrule = match:class xdg-desktop-portal-gtk, center on float on size 900 600
windowrule = match:class google-chrome, match:title (Open|Save) Files, center on, float on, size 900 550


windowrule = workspace 4 silent, match:initial_class ^(discord)$

# PWAs
windowrule = workspace 3 silent, match:initial_title ^(Claude)$
windowrule = workspace 3 silent, match:initial_title ^(Gemini)$
windowrule = workspace 3 silent, match:initial_title ^(DeepSeek)$
windowrule = workspace 3 silent, match:initial_title ^(Perplexity)$
