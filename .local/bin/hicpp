#!/bin/bash
cat <<'EOF' >main.cpp
#include <iostream>

int main() {
  std::cout << "Hello, World!" << '\n';
  return 0;
}
EOF

cat <<'EOF' > .clang-format
BasedOnStyle: LLVM
AlignAfterOpenBracket: BlockIndent
BinPackParameters: false
BinPackArguments: false
ColumnLimit: 120
EOF

cat <<'EOF' >compile_flags.txt
-std=c++20
EOF
