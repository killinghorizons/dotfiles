#tray {
  margin: 2px;
  padding-left: 4px;
  padding-right: 4px;
  color: #ffffff;
}

#tray > .passive {
  -gtk-icon-effect: dim;
}

#tray > .needs-attention {
  -gtk-icon-effect: highlight;
  background-color: #eb4d4b;
}

#taskbar {
  background: transparent;
  padding: 0 4px;
}

#taskbar button {
  min-width: 0;
  padding: 4px 6px;
  margin: 2px 2px;
  border-radius: 6px;
  background: transparent;
  color: #e4e4ef;
  opacity: 0.5;
  transition: all 0.2s ease;
  border: none;
  box-shadow: none;
}

#taskbar button:hover {
  background: rgba(228, 228, 239, 0.1);
  opacity: 0.8;
}

#taskbar button.active {
  background: rgba(228, 228, 239, 0.15);
  opacity: 1;
  /* border-bottom: 2px solid #ffdd33;  */
  border-bottom: 2px solid #fb4934;
}

#taskbar button.minimized {
  opacity: 0.35;
  text-decoration: line-through;
}

#taskbar button.fullscreen {
  background: rgba(244, 56, 65, 0.2);
  opacity: 1;
}

#workspaces {
  background: transparent;
  padding: 0 4px;
}

#workspaces button {
  min-width: 0;
  padding: 4px 8px;
  margin: 2px 2px;
  background: transparent;
  opacity: 0.4;
  transition: all 0.2s ease;
  border: none;
  box-shadow: none;
  font-size: 16px;
  color: #ebdbb2;
}

#workspaces button:hover {
  background: rgba(228, 228, 239, 0.1);
  opacity: 0.7;
  text-decoration: line-through;
}

#workspaces button.active {
  opacity: 1;
  text-decoration: none;
  color: #db302d;
}

#workspaces button.urgent {
  opacity: 1;
  text-decoration: none;
}

#workspaces button.empty {
  opacity: 0.3;
}

#workspaces button label {
  font-size: 18px;
}
